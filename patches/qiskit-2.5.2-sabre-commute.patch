+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Axis {
+    X,
+    Y,
+    Z,
+}
+
+/// The axis of a standard gate on its (one or two) qubits, if it has one.
+fn gate_axes(gate: StandardGate) -> [Option<Axis>; 2] {
+    use Axis::*;
+    use StandardGate as G;
+    match gate {
+        G::Z | G::S | G::Sdg | G::T | G::Tdg | G::RZ | G::Phase | G::U1 => [Some(Z), None],
+        G::X | G::SX | G::SXdg | G::RX => [Some(X), None],
+        G::Y | G::RY => [Some(Y), None],
+        G::CZ | G::CPhase | G::CRZ | G::CU1 | G::CS | G::CSdg | G::RZZ => [Some(Z), Some(Z)],
+        G::CX | G::CSX | G::CRX | G::RZX => [Some(Z), Some(X)],
+        G::CY | G::CRY => [Some(Z), Some(Y)],
+        G::RXX => [Some(X), Some(X)],
+        G::RYY => [Some(Y), Some(Y)],
+        _ => [None, None],
+    }
+}
